# ============================================================
#  Провайдеры (этап 2). ProxyAPI = OpenAI-совместимый base_url.
# ============================================================
LLM_PROVIDER=openai
EMBED_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Для ProxyAPI: LLM_PROVIDER=proxyapi, ключ и base_url ниже
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
TEMPERATURE=0.2

# Смена EMBED_MODEL требует пересборки индекса: векторы разных моделей несравнимы.
# Система это проверяет и откажется работать со старым индексом.
EMBED_BATCH_SIZE=64
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# ============================================================
#  Пути. NOTES_DIR может указывать наружу проекта.
# ============================================================
NOTES_DIR=./data/notes
RAW_DIR=./data/raw
CHROMA_DIR=./storage/chroma
CACHE_DB=./storage/cache.db
PROMPTS_DIR=./prompts

# ============================================================
#  Чанкинг (этап 1). Размеры — в токенах, не в символах.
# ============================================================
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=500
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_PCT=15
TOKENIZER_ENCODING=o200k_base

# ============================================================
#  Поиск и генерация (этапы 4-5)
# ============================================================
TOP_K=5
OVERFETCH_FACTOR=3
# Порог сходства: фрагменты ниже в контекст не попадают.
# Если после отсечения не осталось ничего - ассистент отвечает "в базе нет",
# не обращаясь к модели.
# Значение подобрано прогоном golden set: zassist eval threshold.
# Порог НЕ является защитой от вопросов на смежные темы - на них фрагменты
# находятся с высоким сходством. Там отказывает сама модель (ветка C промпта).
RELEVANCE_THRESHOLD=0.30
# Доля общих шинглов, при которой фрагменты считаются дублями.
# Перекрытие чанков в 15% гарантированно порождает похожие соседние фрагменты.
DEDUP_THRESHOLD=0.8
MAX_CONTEXT_TOKENS=3000
MAX_ANSWER_TOKENS=1000
# Системный промпт генерации. Файл ищется в PROMPTS_DIR, его содержимое хешируется
# и входит в ключ кэша ответов: правка промпта не отдаёт старые ответы как свежие.
ANSWER_PROMPT_FILE=rag_answer_v2.md
# Сколько пар реплик помнит диалог `ask --repl`. 0 - память выключена.
HISTORY_PAIRS=5
# Сколько предыдущих вопросов подмешивать в ПОИСК, когда текущий выглядит
# уточняющим ("а сколько его ставить?"). 0 - не подмешивать.
FOLLOW_UP_LOOKBACK=1

# --- Оценка через RAGAS (этап 8) ---------------------------------------------
# Интерпретатор ОТДЕЛЬНОГО окружения с RAGAS. Рядом с ядром он не ставится:
# тянет langchain-openai, который откатывает openai до 2.x. Как создать
# окружение и почему именно так - в requirements-eval.txt.
# Если не задан, `eval ragas` честно скажет, чего не хватает, и не упадёт.
# RAGAS_PYTHON=./.venv-eval/Scripts/python.exe

LOG_LEVEL=INFO
